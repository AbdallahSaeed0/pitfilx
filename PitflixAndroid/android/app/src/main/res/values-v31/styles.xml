<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ uses the system SplashScreen API instead of windowBackground
         alone. windowSplashScreenAnimatedIcon is shown centered on the dark
         windowSplashScreenBackground; using the purple "P" glyph (splash_p,
         transparent background) rather than the purple splash_logo.png tile keeps the
         OS splash dark and minimal — a purple mark on dark, no full purple square. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowSplashScreenBackground">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_p</item>
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
