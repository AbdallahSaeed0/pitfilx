{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pitflix",
  "version": "0.3.1",
  "identifier": "Pitflix",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "npm run bundle:prepare && npm run icons:prepare && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "devtools": true,
        "title": "Pitflix",
        "width": 1400,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "resizable": true,
        "maximizable": true,
        "minimizable": true,
        "closable": true,
        "decorations": false,
        "transparent": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/pitflix-api"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDMkNGQ0ZDQ0M5M0I1MzIKUldReXRaUE0vUHdzUENPdWhRbERjODFmd3NSRlFzeDY5V1YwZVV0SExZbmZVZE81NzRGeElyUFEK",
      "endpoints": [
        "https://github.com/AbdallahSaeed0/pitfilx/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
